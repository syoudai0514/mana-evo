{
  "name": "mana-evo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "postinstall": "patch-package",
    "generate:runtime": "node scripts/generate-runtime-master.mjs && node scripts/finalize-monster-runtime.mjs",
    "generate:pwa-assets": "node scripts/generate-pwa-asset-revisions.mjs",
    "predev": "npm run generate:runtime && npm run generate:pwa-assets",
    "pretest": "npm run generate:runtime && npm run generate:pwa-assets",
    "prebuild": "npm run generate:runtime && npm run generate:pwa-assets",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "onnxruntime-web": "^1.24.3",
    "piper-plus": "^0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "patch-package": "^8.0.1"
  }
}
